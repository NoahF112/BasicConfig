return {
	"nvim-treesitter/nvim-treesitter",
	-- branch = "master",
	branch = "main",
	build = ":TSUpdate",
	config = function()
		require("nvim-treesitter.configs").setup({
			ensure_installed = {
				"c",
				"lua",
				"vim",
				"vimdoc",
				"query",
				"elixir",
				"heex",
				"javascript",
				"typescript",
				"html",
				"markdown",        -- 👈 Uncommented
				"markdown_inline", -- 👈 Uncommented
				"rust",
			},
			auto_install = true,
			sync_install = false,

			highlight = {
				enable = true,
				disable = { "markdown", "markdown_inline" }, -- Disables TS highlight for markdown
			},

			indent = {
				enable = true,
				disable = { "markdown" },
			},

			additional_vim_regex_highlighting = false,
		})
	end,
}
